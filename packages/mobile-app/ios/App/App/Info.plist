<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Theatre Reader</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		Découverte du Mac sur le réseau local. Ces trois clés vont ensemble ; il en
		manque une et la découverte échoue en silence.

		- NSAllowsLocalNetworking : exception App Transport Security prévue par Apple
		  pour le HTTP en clair vers les noms Bonjour `.local` et le link-local. C'est
		  elle qui rend `http://theatre-reader.local:3001` possible sans ouvrir un
		  NSAllowsArbitraryLoads général. Elle ne couvre PAS les IP privées
		  192.168.x.x : d'où le choix d'annoncer un nom `.local` côté serveur
		  (server/src/discovery.ts) plutôt qu'une adresse.
		- NSLocalNetworkUsageDescription : texte de la demande de permission iOS 14+.
		  Sans elle, la permission n'est jamais demandée et tout accès LAN est refusé.
		- NSBonjourServices : nécessaire seulement pour parcourir Bonjour, ce que
		  l'app ne fait pas (elle résout un nom fixe). Déclaré quand même, au cas où
		  iOS durcirait la résolution `.local`.

		Ce sont des clés Info.plist, pas des entitlements : la signature et le profil
		de provisionnement ne changent pas.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Theatre Reader cherche ton Mac sur le réseau local pour y télécharger tes pièces.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_theatre._tcp</string>
	</array>
	<!--
		Répétition vocale (SpeechPlugin.swift). Les deux clés sont exigées ensemble :
		la reconnaissance d'Apple lit le micro, donc iOS demande les deux permissions,
		et il en manque une pour que l'app soit terminée à la première tentative
		d'écoute — sans message, sans journal, avant même la demande.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Theatre Reader écoute tes répliques pour vérifier que tu les dis juste. Le micro ne s'ouvre que sur tes répliques, en mode répétition.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Theatre Reader transcrit tes répliques pour les comparer au texte de la pièce. Rien n'est enregistré ni conservé après la vérification.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
